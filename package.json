{
  "name": "docuharvest",
  "version": "0.1.0",
  "description": "DocuHarvest — Private Documentation Collector Chrome Extension",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run --pool=forks",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/node": "^26.6.5",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vitest": "^5.0.3",
    "wxt": "^0.19.14"
  }
}
